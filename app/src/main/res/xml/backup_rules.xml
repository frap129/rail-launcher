<?xml version="1.0" encoding="utf-8"?><!--
   Every Rail preference lives in the one Room database, including the rows that
   belong to a Private Space Profile. Per-file backup rules cannot separate
   those rows, so the whole database is excluded. See ADR 0003.
-->
<full-backup-content>
    <exclude
        domain="database"
        path="." />
</full-backup-content>
