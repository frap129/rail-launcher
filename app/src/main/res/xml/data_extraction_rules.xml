<?xml version="1.0" encoding="utf-8"?><!--
   Every Rail preference lives in the one Room database, including the rows that
   belong to a Private Space Profile. Per-file rules cannot separate those rows,
   so the whole database is excluded from both cloud backup and device transfer.
   See ADR 0003.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="." />
    </device-transfer>
</data-extraction-rules>
