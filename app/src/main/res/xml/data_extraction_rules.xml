<?xml version="1.0" encoding="utf-8"?><!--
   Android 12 and higher use this file for cloud backup and device transfer.
   Both keep their default include for the AppDatabase: the Room database, its
   private-profile rows and the SQLite WAL and -shm files. See ADR 0004.

   The Last-known App list is derived, rebuildable data that must be rebuilt on
   the device, not restored, so its separate database is excluded from both.
   See ADR 0005.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="last-known-apps" />
        <exclude domain="database" path="last-known-apps-wal" />
        <exclude domain="database" path="last-known-apps-shm" />
        <exclude domain="database" path="last-known-apps-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="last-known-apps" />
        <exclude domain="database" path="last-known-apps-wal" />
        <exclude domain="database" path="last-known-apps-shm" />
        <exclude domain="database" path="last-known-apps-journal" />
    </device-transfer>
</data-extraction-rules>
