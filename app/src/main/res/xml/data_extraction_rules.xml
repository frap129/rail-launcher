<?xml version="1.0" encoding="utf-8"?><!--
   Android 12 and higher use this file for cloud backup and device transfer.
   Both keep their default behavior, which includes the whole database
   directory: the Room database, its private-profile rows and the SQLite WAL
   and -shm files. See ADR 0004.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
