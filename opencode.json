{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["opencode-rules@latest"],
  "mcp": {
    "servers": {
      "android": {
        "type": "local",
        "command": ["nix", "develop", "--command", "npx", "-y", "android-mcp-server"],
        "cwd": ".",
        "timeout": 90000
      }
    }
  },
  "permissions": [
    {
      "action": "android_start_emulator",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
